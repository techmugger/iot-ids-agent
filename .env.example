# Copy this file to .env and fill in your real keys. Never commit .env.

# Groq API key -- powers the Planner + Executor (Llama-3-8B)
GROQ_API_KEY=your_groq_api_key_here
PLANNER_MODEL=llama3-8b-8192

# Mistral API key -- powers the Evaluator (Mistral Medium)
MISTRAL_API_KEY=your_mistral_api_key_here
EVALUATOR_MODEL=mistral-medium-latest

# Agent behavior
MAX_ITERATIONS=8
MAX_TOOL_CALLS_PER_SESSION=30
REPLAY_INTERVAL_MS=50

# Which trained IDS artifact set to load (must match a models/<prefix>_*.pkl set)
IDS_ARTIFACT_PREFIX=unsw
